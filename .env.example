# Copy to .env (git-ignored). Names only here — never commit real values.

# Network: testnet only for HackMeridian
STELLAR_NETWORK=stellar:testnet

# x402 facilitator. Check GET <url>/supported lists stellar:testnet before using it.
# Default: x402.org testnet facilitator (no API key, fees sponsored).
FACILITATOR_URL=https://x402.org/facilitator
# Only if you switch to OpenZeppelin Channels (https://channels.openzeppelin.com/x402/testnet):
OZ_API_KEY=

# Services side: public G... account that receives USDC. Needs a USDC trustline.
SERVICE_RECIPIENT=

# Agent side: S... secret of the venue agent wallet. Needs a USDC trustline and testnet USDC.
AGENT_SECRET_KEY=

# Where the agent finds the paid services, and the port they listen on
SERVICES_URL=http://localhost:3001
SERVICES_PORT=3001

# Operator treasury (public G... key). Enables the SEP-41 draw and the sponsor slot, which pays this account.
TREASURY_PUBLIC_KEY=
# Only for agent/sponsor.mjs: S... secret of a separate testnet wallet holding testnet USDC (ci-run.mjs makes a throwaway one).
SPONSOR_SECRET_KEY=

# agent/setup-testnet.mjs fills SERVICE_RECIPIENT and AGENT_SECRET_KEY for you and writes this file as .env

# Existing venue wallet pilot (disabled in Production)
# Server configuration only. Never copy these credentials into dist/.
# Use Vercel's Development environment or an ignored .env.wallet.local file.
WALLET_ENABLED=false
WALLET_ORIGIN=https://agenticreality.space
WALLET_CAMPAIGN=one16-testnet-pilot-v1

# OpenZeppelin Channels TESTNET key, obtained from the official testnet service.
CHANNELS_API_KEY=

# Vercel Marketplace injects KV_REST_API_URL / KV_REST_API_TOKEN.
# Direct Upstash credentials can instead use the UPSTASH_ names below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional comma-separated exact HTTPS origins for an explicitly trusted preview.
# The deployed Vercel Preview origin is also handled by server configuration.
WALLET_ALLOWED_ORIGINS=

# Advertising MVP: names only. Copy commercial terms from config/ads.example.json.
ADS_CHECKOUT_ENABLED=
ADS_CONFIG_PATH=
ADS_CONFIG_JSON=
ADS_ORIGIN=
ADS_DATABASE_URL=
ADS_RPC_URL=
ADS_FACILITATOR_URL=
ADS_STORAGE_KIND=
ADS_STORAGE_ROOT=
BLOB_READ_WRITE_TOKEN=
AI_GATEWAY_API_KEY=
ADS_DEFAULT_STAGE_URL=
ADS_PUBLISHER_ORIGIN=
ADS_PUBLISHER_TOKEN=
ADS_PUBLISHER_PRIVATE_KEY_FILE=
ADS_PUBLISHER_PUBLIC_KEY_FILE=
ADS_REFUND_SIGNER_KEY_FILE=
ADS_REGISTRY_CONTRACT=
ADS_REGISTRY_SIGNER_KEY=
ADS_REGISTRY_SIGNER_KEY_FILE=
ADS_EXPECTED_SETTLEMENTS=
ADS_EVIDENCE_SINCE=
# Test-only database must be named ads_test, and requires NODE_ENV=test.
ADS_TEST_DATABASE_URL=

# Buyer controls: DISABLED -> CONTROLLED -> PUBLIC. Only public C-addresses, never secrets.
ADS_CHECKOUT_MODE=
ADS_ALLOWED_BUYERS_JSON=
