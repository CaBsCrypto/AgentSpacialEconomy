# Copy to .env (git-ignored). Names only here — never commit real values.

# Network: testnet only for HackMeridian
STELLAR_NETWORK=stellar:testnet

# x402 facilitator. Check GET <url>/supported lists stellar:testnet before using it.
# Default: x402.org testnet facilitator (no API key, fees sponsored).
FACILITATOR_URL=https://x402.org/facilitator
# Only if you switch to OpenZeppelin Channels (https://channels.openzeppelin.com/x402/testnet):
OZ_API_KEY=

# Services side: public G... account that receives USDC. Needs a USDC trustline.
SERVICE_RECIPIENT=

# Agent side: S... secret of the venue agent wallet. Needs a USDC trustline and testnet USDC.
AGENT_SECRET_KEY=

# Where the agent finds the paid services, and the port they listen on
SERVICES_URL=http://localhost:3001
SERVICES_PORT=3001

# Operator treasury (public G... key). Enables the SEP-41 draw and the sponsor slot, which pays this account.
TREASURY_PUBLIC_KEY=
# Only for agent/sponsor.mjs: S... secret of a separate testnet wallet holding testnet USDC (ci-run.mjs makes a throwaway one).
SPONSOR_SECRET_KEY=

# agent/setup-testnet.mjs fills SERVICE_RECIPIENT and AGENT_SECRET_KEY for you and writes this file as .env

# Existing venue wallet pilot (disabled in Production)
# Server configuration only. Never copy these credentials into dist/.
# Use Vercel's Development environment or an ignored .env.wallet.local file.
WALLET_ENABLED=false
WALLET_ORIGIN=https://agenticreality.space
WALLET_CAMPAIGN=one16-testnet-pilot-v1

# OpenZeppelin Channels TESTNET key, obtained from the official testnet service.
CHANNELS_API_KEY=

# Vercel Marketplace injects KV_REST_API_URL / KV_REST_API_TOKEN.
# Direct Upstash credentials can instead use the UPSTASH_ names below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional comma-separated exact HTTPS origins for an explicitly trusted preview.
# The deployed Vercel Preview origin is also handled by server configuration.
WALLET_ALLOWED_ORIGINS=

# Reuse reviewed capacity in the existing PostgreSQL service with an explicit schema/role.
# Both new-operation switches remain off until the public Testnet release gates pass.
# Pausing intake preserves authenticated reads and reconciliation when coverage is valid.
# These environment ceilings require a new deployment to change. The live PostgreSQL
# gate starts closed after migration 003; see docs/reservations-intake.md for the CLI.
RESERVATIONS_ENABLED=false
RESERVATIONS_INTAKE_ENABLED=false
RESERVATIONS_MODE=DISABLED
# CONTROLLED uses an explicit server-side comma-separated Testnet brand wallet allowlist.
# Never switch to PUBLIC before H4 acceptance and the observation gate.
RESERVATIONS_ALLOWED_BRANDS=
# Set explicitly; never auto-fall back to Ads settings and never provision another service.
RESERVATIONS_DATABASE_URL=
RESERVATIONS_HOST_ADDRESS=
RESERVATIONS_PROJECT_ID=
RESERVATIONS_CONTRACT_ID=
RESERVATIONS_CONTRACT_WASM_HASH=
# Private Vercel Blob credential; files are served only through authorized API routes.
BLOB_READ_WRITE_TOKEN=
# @vercel/blob defaults to automatic retries; explicit zero is required by quota accounting.
VERCEL_BLOB_RETRIES=0
# Existing AI Gateway credentials only. Hosted requests may use verified Vercel OIDC.
AI_GATEWAY_API_KEY=
# Explicit operator-verified coverage manifest, defaults to no permission.
# See docs/reservations-backend.md. A credit balance by itself does not enable AI.
RESERVATIONS_RESOURCE_COVERAGE={}
# Optional native test DB: NODE_ENV=test, database must be exactly reservations_test.
RESERVATIONS_TEST_DATABASE_URL=
